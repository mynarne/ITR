        "id": "stock-zero",
        "title": "빈 재고 경계의 표시",
        "stage": "acceptance",
        "method": "execution",
        "criteria": [
          "G-STOCK",
          "R-LABEL",
          "S-EVIDENCE"
        ],
        "pass_condition": "수량 0을 조회한 담당자에게 empty가 표시되고 수량·기대값·실제값이 기록된다.",
        "requires": [
          "local_command"
        ],
        "role": "runner",
        "selected": true,
        "depends_on": [],
        "standards": [
          {
            "ref": "ISO/IEC 25010:2023",
