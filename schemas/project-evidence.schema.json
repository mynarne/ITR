{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ITR 로컬 프로젝트 실행 증거 2.0",
  "description": "계획 인수와 실제 Popen 호출 인수를 별도로 저장한다. 경로 지문과 계획 일치 여부는 project.py verify가 추가로 확인한다.",
  "type": "object",
  "required": [
    "evidence_schema_version",
    "argv",
    "launch_argv",
    "exit_code",
    "status"
  ],
  "properties": {
    "evidence_schema_version": {
      "const": "2.0"
    },
    "argv": {
      "$ref": "#/$defs/args"
    },
    "launch_argv": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/args"
        }
      ],
      "description": "Popen에 전달한 인수 배열. 호출 전에 차단한 경우 null."
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer"
        }
      ]
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "not_run"
      ]
    }
  },
  "if": {
    "properties": {
      "launch_argv": {
        "type": "null"
      }
    },
    "required": [
      "launch_argv"
    ]
  },
  "then": {
    "properties": {
      "status": {
        "const": "blocked"
      },
      "exit_code": {
        "type": "null"
      }
    }
  },
  "$defs": {
    "args": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[^\\u0000]*$"
      }
    }
  }
}
