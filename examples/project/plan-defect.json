      "argv": [
        "{python}",
        "-I",
        "-B",
        "checks.py",
        "regular"
      ],
      "timeout_s": 5,
      "pass_marker": "remaining=5 expected=ready actual=ready"
    },
    "stock-low": {
      "argv": [
        "{python}",
        "-I",
        "-B",
        "checks.py",
        "low"
      ],
      "timeout_s": 5,
      "pass_marker": "remaining=2 expected=low actual=low"
    },
    "stock-zero": {
      "argv": [
        "{python}",
        "-I",
        "-B",
        "checks.py",
        "zero"
      ],
      "timeout_s": 5,
      "fingerprint": "inventory.zero.label",
      "pass_marker": "remaining=0 expected=empty actual=empty"
    }
  },
  "standards": [
    {
      "edition": "ISO/IEC 25010:2023",
