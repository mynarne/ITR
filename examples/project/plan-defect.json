    {
      "edition": "ISO/IEC 25019:2023",
      "applied": true,
      "reason": "재고 담당자가 빈 재고를 알아볼 수 있는지 인수 시나리오의 적합성으로 확인한다."
    },
    {
      "edition": "ISO/IEC/IEEE 29119-4:2021",
      "applied": true,
      "reason": "고정한 재고 구간의 대표값과 경계값으로 검사를 설계한다."
    },
    {
      "edition": "ISO/IEC 20246:2017",
      "applied": false,
      "reason": "이번 예제 계획의 선택 범위는 CLI 실행이며 별도 산출물 인스펙션을 하지 않는다."
    }
  ]
